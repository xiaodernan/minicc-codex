# M8-T1331 — offline local LLM profile (no Clash, no external endpoint).
#
# WHY: the external provider needed Clash DNS; the RTX 3060 CUDA path crashes
# llama-server (0xc0000409 "device kernel image is invalid"). CPU mode works.
#
# HOW TO USE:
#   1. powershell -ExecutionPolicy Bypass -File scripts/start_local_llm.ps1
#      (wait for it to print READY; it pins OLLAMA_NUM_GPU=0)
#   2. copy this file over .env:  Copy-Item env.local-llm.example .env
#   3. run minicc as usual — no proxy, no network needed.
#
# To go back to the external endpoint, restore your old .env (it is gitignored;
# keep a copy). These values are also settable as plain environment variables.

MINICC_BASE_URL=http://127.0.0.1:11434/v1
MINICC_API_KEY=ollama
MINICC_MODEL=qwen2.5:7b
MINICC_LLM_PROTOCOL=chat_completions

# No proxy — everything is loopback.
# (Do NOT set HTTP_PROXY/HTTPS_PROXY/ALL_PROXY.)
