[{"id": "v2-license-mit", "category": "write", "suite_version": "v2-1", "allow_changes": true, "max_minutes": 5, "prompt": "在仓库根目录创建 LICENSE 文件，内容为标准 MIT 许可证，版权行写 'Copyright (c) 2026 MiniCC'。不要修改其他文件。", "fixture": {"README.md": "# demo-project\n\nA tiny project that needs a license.\n"}, "grader": {"type": "file_contract", "files": [{"path": "LICENSE", "contains": "MIT License"}, {"path": "LICENSE", "contains": "Copyright (c) 2026 MiniCC"}]}}, {"id": "v2-greeting-already-correct", "category": "write", "suite_version": "v2-1", "allow_changes": true, "max_minutes": 5, "prompt": "确认 greeting.txt 的内容是 'hello world'。如果已经正确就保持不变。", "fixture": {"greeting.txt": "hello world\n"}, "grader": {"type": "file_contract", "files": [{"path": "greeting.txt", "contains": "hello world"}]}}, {"id": "v2-greeting-needs-fix", "category": "write", "suite_version": "v2-1", "allow_changes": true, "max_minutes": 5, "prompt": "greeting.txt 目前只是占位符。把它的内容改成 'hello world'。", "fixture": {"greeting.txt": "TODO\n"}, "grader": {"type": "file_contract", "files": [{"path": "greeting.txt", "contains": "hello world"}]}}, {"id": "v2-config-json", "category": "write", "suite_version": "v2-1", "allow_changes": true, "max_minutes": 6, "prompt": "把 config.json 写成恰好包含两个键的 JSON 对象：debug 为 true，port 为 8080。不要有多余的键。", "fixture": {"config.json": "{}\n", "README.md": "# config\n\nFill in config.json.\n"}, "grader": {"type": "file_contract", "files": [{"path": "config.json", "json_equals": {"debug": true, "port": 8080}}]}}, {"id": "v2-greet-function", "category": "write", "suite_version": "v2-1", "allow_changes": true, "max_minutes": 6, "prompt": "在 main.py 中定义函数 greet(name)，返回字符串 'Hello, {name}!'。保持文件可被 import。", "fixture": {"main.py": ""}, "grader": {"type": "file_contract", "files": [{"path": "main.py", "regex": "def\\s+greet\\s*\\(\\s*name"}, {"path": "main.py", "contains": "Hello,"}]}}, {"id": "v2-env-example", "category": "write", "suite_version": "v2-1", "allow_changes": true, "max_minutes": 5, "prompt": "创建 .