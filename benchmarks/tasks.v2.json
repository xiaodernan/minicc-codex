 run():\n    return \"running\"\n"}, "grader": {"type": "file_contract", "files": [{"path": "pkg/__init__.py", "contains": "VERSION"}, {"path": "pkg/__init__.py", "regex": "run"}]}}, {"id": "v2-two-outputs", "category": "multi-file", "suite_version": "v2-1", "allow_changes": true, "max_minutes": 6, "prompt": "把 a.txt 的内容写成大写字母 'A'，把 b.txt 的内容写成大写字母 'B'。两个文件都要存在。", "fixture": {"a.txt": "", "b.txt": ""}, "grader": {"type": "file_contract", "files": [{"path": "a.txt", "contains": "A"}, {"path": "b.txt", "contains": "B"}]}}, {"id": "v2-package-manifest", "category": "multi-file", "suite_version": "v2-1", "allow_changes": true, "max_minutes": 8, "prompt": "把 package.json 写成恰好包含 name 为 'app'、main 为 'app.js'、version 为 '1.0.0' 三个键的 JSON。app.js 保持存在。", "fixture": {"package.json": "{}\n", "app.js": "console.log('app');\n"}, "grader": {"type": "file_contract", "files": [{"path": "package.json", "json_equals": {"name": "app", "main": "app.js", "version": "1.0.0"}}, {"path": "app.js", "exists": true}]}}, {"id": "v2-docs-pair", "category": "multi-file", "suite_version": "v2-1", "allow_changes": true, "max_minutes": 8, "prompt": "补全 docs/intro.md 与 docs/api.md：intro.md 必须以一级标题 '# Intro' 开头，api.md 必须以一级标题 '# API' 开头。", "fixture": {"docs/intro.md": "", "docs/api.md": ""}, "grader": {"type": "file_contract", "files": [{"path": "docs/intro.md", "regex": "^# Intro"}, {"path": "docs/api.md", "regex": "^# API"}]}}, {"id": "v2-fix-add", "category": "test-fix", "suite_version": "v2-1", "allow_changes": true, "max_minutes": 10, "prompt": "calc.py 里的 add 函数有 bug，测试 test_calc.py 失败了。修复 calc.py 让测试通过，不要修改测试文件。", "fixture": {"calc.py": "def add(a, b):\n    return a - b\n", "test_calc.py": "from calc import add\n\n\ndef test_add():\n    assert add(2, 3) == 5\n"}, "grader": {"type": "command_contract", "command": "{python} -m pytest -q test_calc.py", "expect_exit": 0}}, {"id": "v2-fix-range", "category": "test-fix", "suite_version": "v2-1", "allow_changes": true, "max_minutes": 10, "prompt": "rng.py 的 first_n(n) 应返回 [0, 1, ..., n-1]，当前实现少了一个元素。修复 rng.py 使 test_rng.py 通过，不要改测试。", "fixture": {"rng.py": "def first_n(n):\n    return list(range(1, n))\n", "test_rng.py": "from rng import first_n\n\n\ndef test_first_n():\n    assert first_n(3) == [0, 1, 2]\n"}, "grader": {"type": "command_contract", "command": "{python} -m pytest -q test_rng.py", "expect_exit": 0}}, {"id": "v2-fix-keyerror", "category": "test-fix", "suite_version": "v2-1", "allow_changes": true, "max_minutes": 10, "prompt": "lookup.py 的 get_or_default 在键不存在时抛 KeyError，应返回 default。修复 lookup.py 使 test_lookup.py 通过，不要改测试。", "fixture": {"lookup.py": "def get_or_default(data, key, default=None):\n    return data[key]\n", "test_lookup.py": "from lookup import get_or_default\n\n\ndef test_missing_key():\n    assert get_or_default({\"a\": 1}, \"b\", 0) == 0\n\n\ndef test_present_key():\n    assert get_or_default({\"a\": 1}, \"a\", 0) == 1\n"}, "grader": {"type": "command_contract", "command": "{python} -m pytest -q test_lookup.py", "expect_exit": 0}}, {"id": "v2-fix-slug", "category": "test-fix", "suite_version": "v2-1", "allow_changes": true, "max_minutes": 10, "prompt": "slug.py 的 slugify 没有去掉首尾空白也没有折叠连续空格。修复 slug.py 使 test_slug.py 通过，不要改测试。", "fixture": {"slug.py": "def slugify(text):\n    return text.lower().replace(' ', '-')\n", "test_slug.py": "from slug import slugify\n\n\ndef test_slugify():\n    assert slugify('  Hello   World  ') == 'hello-world'\n"}, "grader": {"type": "command_contract", "command": "{python} -m pytest -q test_slug.py", "expect_exit": 0}}, {"id": "v2-fix-package-tests", "category": "multi-file", "suite_version": "v2-1", "allow_changes": true, "max_minutes": 12, "prompt": "src/money.py 的 format_cents 把分转成元时有 off-by-one。修复 src/money.py 使 tests/ 下的测试全部通过，不要改测试。", "fixture": {"src/__init__.py": "", "src/money.py": "def format_cents(cents):\n    return f\"{(cents + 1) / 100:.2f}\"\n", "tests/__init__.py": "", "tests/test_money.py": "from src.money import format_cents\n\n\ndef test_format():\n    assert format_cents(1234) == \"12.34\"\n    assert format_cents(0) == \"0.00\"\n"}, "grader": {"type": "command_contract", "command": "{python} -m pytest -q tests", "expect_exit": 0}}, {"id": "v2-gitignore", "category": "write", "suite_version": "v2-1", "allow_changes": true, "max_minutes": 5, "prompt": "创建 .gitignore，至少忽略 __pycache__/ 和 *.pyc。", "fixture": {"README.md": "# py project\n"}, "grader": {"type": "file_contract", "files": [{"path": ".gitignore", "contains": "__pycache__"}, {"path": ".gitignore", "contains": "*.pyc"}]}}, {"id": "v2-schema-json", "category": "write", "suite_version": "v2-1", "allow_changes": true, "max_minutes": 8, "prompt": "创建 schema.json，内容为一个 JSON 对象，恰好包含 title 为 'User'、type 为 'object'、required 为 ['id', 'name'] 三个键。", "fixture": {"README.md": "# schema\n"}, "grader": {"type": "file_contract", "files": [{"path": "schema.json", "json_equals": {"title": "User", "type": "object", "required": ["id", "name"]}}]}}, {"id": "v2-fix-uppercase", "category": "test-fix", "suite_version": "v2-1", "allow_changes": true, "max_minutes": 10, "prompt": "shout.py 的 shout 应返回大写并带感叹号，当前忘了加感叹号。修复 shout.py 使 test_shout.py 通过，不要改测试。", "fixture": {"shout.py": "def shout(text):\n    return text.upper()\n", "test_shout.py": "from shout import shout\n\n\ndef test_shout():\n    assert shout('hi') == 'HI!'\n"}, "grader": {"type": "command_contract", "command": "{python} -m pytest -q test_shout.py", "expect_exit": 0}}, {"id": "v2-multi-config", "category": "multi-file", "suite_version": "v2-1", "allow_changes": true, "max_minutes": 8, "prompt": "同时更新两个配置：settings.json 写成 {'theme': 'dark'}，defaults.ini 写成含 [core] 小节且 level=1 的 INI 文本。", "fixture": {"settings.json": "{}\n", "defaults.ini": ""}, "grader": {"type": "file_contract", "files": [{"path": "settings.json", "json_equals": {"theme": "dark"}}, {"path": "defaults.ini", "contains": "[core]"}, {"path": "defaults.ini", "contains": "level=1"}]}}, {"id": "v2-fix-mean", "category": "test-fix", "suite_version": "v2-1", "allow_changes": true, "max_minutes": 10, "prompt": "stats.py 的 mean 用了错误的分母（len-1）。修复 stats.py 使 test_stats.py 通过，不要改测试。", "fixture": {"stats.py": "def mean(values):\n    return sum(values) / (len(values) - 1)\n", "test_stats.py": "from stats import mean\n\n\ndef test_mean():\n    assert mean([1, 2, 3]) == 2\n"}, "grader": {"type": "command_contract", "command": "{python} -m pytest -q test_stats.py", "expect_exit": 0}}]